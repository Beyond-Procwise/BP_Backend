# Install (no sudo; the muthu user lingers, so this survives logout and reboot):
#   cp deploy/systemd-user/procwise-health-alerts.* ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now procwise-health-alerts.timer
# Watch: journalctl --user -u procwise-health-alerts.service -f
[Unit]
Description=Check ProcWise health signals every 5 minutes

[Timer]
OnBootSec=2min
# OnCalendar, not OnUnitActiveSec: bp-extraction-health uses the latter, went
# "elapsed" with no next trigger, and has not fired since May.
OnCalendar=*:0/5
Persistent=true

[Install]
WantedBy=timers.target

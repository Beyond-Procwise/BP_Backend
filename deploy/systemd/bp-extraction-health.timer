[Unit]
Description=Run bp-extraction-health.service every 5 minutes

[Timer]
# Wall-clock schedule: fire at minutes 0,5,10,... of every hour.
#
# The previous config used only monotonic triggers (OnBootSec + OnUnitActiveSec).
# That chain is fragile: OnUnitActiveSec re-arms the next run only after the
# service successfully becomes active, and Persistent= has NO effect on monotonic
# timers. So a single missed/failed firing (or a reboot after OnBootSec had
# elapsed) left the timer with NextElapse=infinity and it never recovered — the
# health check silently stopped for 48 days (FINDINGS.md F12).
#
# OnCalendar is self-healing: the next firing is always computed from the wall
# clock, independent of prior runs, and Persistent=true (which IS honoured for
# calendar timers) catches up a firing missed during host downtime.
OnCalendar=*:0/5
Persistent=true
AccuracySec=30s
Unit=bp-extraction-health.service

[Install]
WantedBy=timers.target

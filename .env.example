# Extraction pipeline feature flags (per category). Default v3 — the unified
# schema-driven pipeline (LayoutLMv3 + Table Transformer + sBERT + spaCy NER +
# extractive QA + vendor templates, with LLM as a layered judge). Flip back to
# `agentnick` only as an emergency rollback (legacy code is being removed).
EXTRACTION_PIPELINE_INVOICE=v3
EXTRACTION_PIPELINE_PURCHASE_ORDER=v3
EXTRACTION_PIPELINE_QUOTE=v3
EXTRACTION_PIPELINE_CONTRACT=v3

# AI translation (src/services/i18n). English is the source; any other language is translated on demand.
TRANSLATION_PROVIDER=ollama
# TRANSLATION_BASE_URL defaults to OLLAMA_BASE_URL
TRANSLATION_MODEL=BeyondProcwise/AgentNick:unified
TRANSLATION_TEMPERATURE=0.1
TRANSLATION_TIMEOUT=120
TRANSLATION_BATCH_SIZE=40
TRANSLATION_THINK=false
TRANSLATION_MEMORY_CACHE_SIZE=20000
# In-memory entries expire so a reviewed import (made by the CLI) is served without a restart
TRANSLATION_MEMORY_TTL_SECONDS=600
# Background translation waits while extraction/chat wants the GPU, or while the card is
# at least this % busy (other processes); 0 turns the card check off
TRANSLATION_YIELD_GPU_UTIL=30
TRANSLATION_YIELD_POLL_SECONDS=2
# Slot values for the prompts ({{DO_NOT_TRANSLATE_LIST}}, {{GLOSSARY}}, {{TONE}}); default config/i18n/translation.json
# TRANSLATION_CONFIG_FILE=
# Longest batch in characters (a batch closes at BATCH_SIZE strings OR this many chars)
TRANSLATION_BATCH_CHARS=6000
# A string that fails twice is served in English and not re-sent for this long
TRANSLATION_FAILURE_BACKOFF_SECONDS=900
# Max strings waiting in the background queue (screen work evicts background work when full)
TRANSLATION_QUEUE_LIMIT=20000

{
 "id": "002-thread-vs-postgres-conflict",
 "family": "negotiation_counter",
 "description": "The request says 49.00; Postgres says 47.50. Postgres wins and the conflict is shown.",
 "run": {
  "path": "counter",
  "payload": {
   "supplier_id": "S-1",
   "workflow_id": "wf-1",
   "supplier_name": "Acme Ltd",
   "recipients": [
    "alex@acme.test"
   ],
   "current_offer": 49.0,
   "currency": "GBP",
   "counter_price": 44.8,
   "response_deadline": "30 October 2026",
   "asks": [
    "Confirm revised pricing"
   ],
   "rationale": "Anchor below their offer",
   "reasoned_basis": {
    "response_deadline": [
     "email_thread_summary"
    ]
   }
  }
 },
 "model": {
  "compose": "Subject: Re: Pricing for your quotation\nDear Alex Morgan,\n\nThank you for your latest offer of 47.50 GBP. We would like to propose 44.80 GBP for this order. Could you please confirm whether you can agree this price by 30 October 2026?\n\nKind regards,\nProcurement Team",
  "judge": {
   "scores": {
    "ask_is_specific": 5,
    "position_follows_from_offer": 4,
    "deadline_stated": 5,
    "tone_matches_escalation_level": 4,
    "concise": 4
   },
   "rationale": "clear"
  }
 },
 "expect": {
  "rec.conflicts[*].fact": {
   "has": "supplier_current_offer"
  },
  "rec.conflicts[*].resolution": {
   "has": "postgres_wins"
  },
  "rec.conflicts[*].supplied": {
   "has": 49.0
  },
  "rec.facts.supplier_current_offer.value": {
   "contains": "47.5"
  },
  "draft.metadata.current_offer": 47.5,
  "rec.status": "needs_review",
  "view.conflicts[*].label": {
   "has": "Supplier's latest offer"
  }
 }
}
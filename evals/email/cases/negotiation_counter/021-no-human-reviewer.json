    "ask_is_specific": 5,
    "position_follows_from_offer": 4,
    "deadline_stated": 5,
    "tone_matches_escalation_level": 4,
    "concise": 4
   },
   "rationale": "clear"
  }
 },
 "expect": {
  "send.allowed": false,
  "send.reason": {
   "contains": "no human"
  }
 }
}
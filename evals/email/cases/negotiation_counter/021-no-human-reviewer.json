{
 "id": "021-no-human-reviewer",
 "family": "negotiation_counter",
 "description": "An autonomous send of an agent-initiated draft is refused outright.",
 "run": {
  "path": "counter",
  "payload": {
   "supplier_id": "S-1",
   "workflow_id": "wf-1",
   "supplier_name": "Acme Ltd",
   "recipients": [
    "alex@acme.test"
   ],
   "current_offer": 47.5,
   "currency": "GBP",
   "counter_price": 44.8,
   "response_deadline": "30 October 2026",
   "asks": [
    "Confirm revised pricing"
   ],
   "rationale": "Anchor below their offer",
   "reasoned_basis": {
    "response_deadline": [
     "email_thread_summary"
    ]
   }
  }
 },
 "send": {
  "mode": "shadow",
  "approval": {
   "autonomous": true,
   "agent": "email_dispatch_agent",
   "actioned_by": null
  }
 },
 "model": {
  "compose": "Subject: Re: Pricing for your quotation\nDear Alex Morgan,\n\nThank you for your latest offer of 47.50 GBP. We would like to propose 44.80 GBP for this order. Could you please confirm whether you can agree this price by 30 October 2026?\n\nKind regards,\nProcurement Team",
  "judge": {
